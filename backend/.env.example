# SIROMS backend configuration — copy to backend/.env and fill in.
# backend/.env is git-ignored. NEVER commit real credentials.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string for a database user that has readWrite on
# the SIROMS database ONLY (Atlas → Database Access). Example shape:
# mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=siroms

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# native = MongoDB TTL index (Atlas). interval = periodic cleanup (servers without TTL support).
SESSION_AUTO_REMOVE=native

# auto = use multi-document transactions when the deployment supports them (Atlas does).
MONGO_TRANSACTIONS=auto

# Only needed if the frontend is served from a different origin than the API,
# e.g. VS Code Live Server: http://127.0.0.1:5500  (comma-separated)
CORS_ORIGINS=
# Set to true when running behind a reverse proxy / load balancer that terminates HTTPS.
TRUST_PROXY=false
SERVE_FRONTEND=true

APP_TIMEZONE=Asia/Manila
BCRYPT_ROUNDS=12
# Sign-in attempts allowed per IP address per 15 minutes.
LOGIN_RATE_LIMIT=20

# DEVELOPMENT ONLY — password given to every seeded staff account by `npm run seed`.
# Choose your own (10+ characters). Do not reuse it anywhere else.
SEED_PASSWORD=
# Shows the list of development staff IDs (not passwords) on the login screen. Always off in production.
ENABLE_DEMO_DIRECTORY=true
